# The sandbox replaces these paths with device nodes, git stumbles on them.
# /scripts is the root directory only; games/<game>/scripts (the layer linter) is not affected.
# /.github was removed from here: the deploy lives there (.github/workflows/deploy.yml).
/scripts

# Zero-size stubs that got into the repository via the base snapshot. On disk the
# sandbox holds them (they cannot be deleted, "Device or resource busy"), so we just don't track them.
# An empty root package.json and lock files would otherwise confuse Bun and CI: the game has its own package.json
# in games/snake.
/package.json
/package-lock.json
/pnpm-lock.yaml
/yarn.lock
/bunfig.toml
/.gitmodules

# work-kit: machine-local settings, not part of the game
.work-kit/
.shots/

# Downloaded Kenney CC0 packs - the source for tools/sfx/library.ts, re-download per CREDITS.md
uninvited/tools/sfx/kenney/

# Local benchmark output (tools/bench.ts)
uninvited/bench/results/

# Agents scratch files - never in the repo
uninvited/scratchpad/
